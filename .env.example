# Copy to .env and fill in. Never commit .env.
DB_USER=postgres
DB_PASSWORD=change-me
DB_NAME=amzscoutiq
DATABASE_URL=postgresql://postgres:change-me@localhost:5432/amzscoutiq
SECRET_KEY=your-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
DEBUG=false
GOOGLE_CLIENT_ID=your-client-id
GOOGLE_CLIENT_SECRET=your-secret
DODO_API_KEY=your-dodo-api-key
DODO_WEBHOOK_SECRET=your-dodo-webhook-secret
DODO_BASE_URL=https://test.dodopayments.com
DODO_PRODUCT_ID_PRO=
DODO_PRODUCT_ID_BUSINESS=
SMTP_HOST=smtp.example.com
SMTP_USER=your-user
SMTP_PASSWORD=your-password
SMTP_PORT=587
SMTP_FROM=AmzScoutIQ <no-reply@example.com>
# starttls | ssl | none (SMTP_HOST empty -> emails are only logged)
SMTP_TLS=starttls
# Background worker / BSR alerts
ALERT_BSR_CHANGE_PCT=20
WORKER_INTERVAL_MINUTES=360
AMAZON_DATA_API_KEY=your-data-provider-key
LLM_API_KEY=your-llm-key

# --- Open-dataset provider (optional; default is the built-in mock) -------------------------
# DATA_PROVIDER=mock|dataset. "dataset" serves REAL products/reviews from the Amazon Reviews
# 2023 dataset (McAuley Lab, UCSD) from a local SQLite file. BSR/price are a single Sep-2023
# snapshot, sales figures are estimates. The dataset has NO explicit licence (research use;
# commercial use unresolved): download it yourself, never commit or redistribute it.
# Build the file first (from backend/, ~340 MB download, a minute or two):
#   python -m app.data.import_amazon_2023 --category Appliances --max-products 3000
# If the file is missing the app fails with this command; it never silently falls back to mock.
# Relative paths are relative to the repository root. In docker-compose the path is fixed to
# /app/data/amazon_reviews_2023.sqlite (mounted read-only from DATASET_HOST_DIR, see below).
DATA_PROVIDER=mock
DATASET_PATH=data/amazon_reviews_2023.sqlite
# LLM_PROVIDER=mock|lexicon. "lexicon" = free rule-based sentiment/pain points (no API key);
# recommended together with DATA_PROVIDER=dataset.
LLM_PROVIDER=mock
# docker-compose only: host directory holding the dataset file. Leave empty (default) to mount
# an empty named volume, which is safe when you have no dataset. To use the dataset set
# DATASET_HOST_DIR=./data (the directory must exist).
DATASET_HOST_DIR=
VITE_API_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173"]
# Comma-separated emails promoted to admin on register/login
ADMIN_EMAILS=
# Refresh-token cookie "Secure" flag. false ONLY for http://localhost dev; MUST be true
# (the default) in production behind HTTPS.
COOKIE_SECURE=false
# NOTE: password accounts created before email verification existed are unverified and
# cannot log in until they use POST /api/v1/auth/resend-verification (or reset their password).

# Local file uploads (avatars)
UPLOAD_DIR=uploads
